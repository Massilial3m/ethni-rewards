<div id="ethni-rewards-widget" class="ethni-rewards-widget">
  <p class="ethni-rewards-widget__loading">Chargement de votre solde de points…</p>
</div>

<style>
  .ethni-rewards-widget__balance {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .ethni-rewards-widget__balance-value {
    font-size: 2rem;
    font-weight: 700;
  }
  .ethni-rewards-widget__history {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .ethni-rewards-widget__history th,
  .ethni-rewards-widget__history td {
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .ethni-rewards-widget__redeem {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ethni-rewards-widget__redeem-message {
    margin-top: 0.5rem;
  }
</style>

<script>
  (function () {
    var container = document.getElementById('ethni-rewards-widget');

    fetch('/apps/loyalty/get-balance?_=' + Date.now(), { cache: 'no-store' })
      .then(function (res) {
        if (!res.ok) throw new Error('request failed');
        return res.json();
      })
      .then(function (data) {
        if (!data.customer) {
          container.innerHTML =
            '<p>Connectez-vous à votre compte pour voir votre solde de points Ethni Rewards.</p>';
          return;
        }

        var historyRows = data.transactions
          .map(function (t) {
            var sign = t.points > 0 ? '+' : '';
            var date = new Date(t.createdAt).toLocaleDateString('fr-FR');
            return (
              '<tr><td>' + date + '</td><td>' + (t.note || t.type) +
              '</td><td>' + sign + t.points + '</td></tr>'
            );
          })
          .join('');

        var redeemBlock = '';
        if (data.balance >= 200) {
          redeemBlock =
            '<form id="ethni-rewards-redeem-form" class="ethni-rewards-widget__redeem">' +
              '<label for="ethni-rewards-points-input">Convertir</label>' +
              '<input type="number" id="ethni-rewards-points-input" name="points" ' +
                'min="200" step="25" max="' + data.balance + '" value="200" />' +
              '<span>points (25 pts = 0,50€, mini. 200 pts)</span>' +
              '<button type="submit">Obtenir un code de réduction</button>' +
            '</form>' +
            '<div id="ethni-rewards-redeem-message" class="ethni-rewards-widget__redeem-message"></div>';
        }

        container.innerHTML =
          '<div class="ethni-rewards-widget__balance">' +
            '<span class="ethni-rewards-widget__balance-value">' + data.balance + '</span>' +
            '<span class="ethni-rewards-widget__balance-label">points Ethni Rewards</span>' +
          '</div>' +
          '<table class="ethni-rewards-widget__history">' +
            '<thead><tr><th>Date</th><th>Détail</th><th>Points</th></tr></thead>' +
            '<tbody>' +
              (historyRows || '<tr><td colspan="3">Aucun mouvement pour le moment.</td></tr>') +
            '</tbody>' +
          '</table>' +
          redeemBlock;

        var form = document.getElementById('ethni-rewards-redeem-form');
        if (form) {
          form.addEventListener('submit', function (event) {
            event.preventDefault();
            var messageEl = document.getElementById('ethni-rewards-redeem-message');
            messageEl.textContent = 'Génération du code…';

            fetch('/apps/loyalty/redeem', {
              method: 'POST',
              body: new FormData(form),
              cache: 'no-store',
            })
              .then(function (res) { return res.json(); })
              .then(function (result) {
                if (result.error) {
                  messageEl.textContent =
                    'Impossible de convertir vos points pour le moment. Merci de réessayer.';
                  return;
                }
                messageEl.textContent =
                  'Code ' + result.code + ' : ' + result.amount + '€ de réduction. Utilisez-le au paiement.';
              })
              .catch(function () {
                messageEl.textContent = 'Une erreur est survenue, merci de réessayer.';
              });
          });
        }
      })
      .catch(function () {
        container.innerHTML = '<p>Impossible de charger votre solde pour le moment.</p>';
      });
  })();
</script>

{% schema %}
{
  "name": "Solde Ethni Rewards",
  "target": "section"
}
{% endschema %}
